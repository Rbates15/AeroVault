{
  "name": "aerovault",
  "version": "1.0.0",
  "description": "AeroVault — a realistic flight-booking demonstration application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm run dev --prefix client",
